# ------------------------------------------------------------------
# QA Automation Tool — Environment Configuration
# Copy this file to `.env` and adjust values as needed.
# Real environment variables override values in this file.
# ------------------------------------------------------------------

# --- Server ---
PORT=3000

# --- Ollama (AI exploratory testing) ---
OLLAMA_URL=http://127.0.0.1:11434

# --- Browser ---
# true  = run browsers in the background (no visible window, faster, CI-friendly)
# false = show the browser window while tests run (useful for debugging)
HEADLESS=false

# Delay (ms) between Playwright actions. Leave empty to use each engine's
# default (300ms for scripted/suite/accessibility, 400ms for exploratory).
# Set to 0 for maximum speed.
SLOW_MO=

